# セッション暗号化鍵（32バイト以上・Base64 または 64桁 Hex。本番は `wrangler secret put SESSION_SECRET` で設定）
SESSION_SECRET=replace-with-32-byte-random-secret-for-local-dev-only

# 公開オリジン（本番は https://editor.zumen.dev、開発時は http://127.0.0.1:24120）
APP_ORIGIN=http://127.0.0.1:24120

# Sign in with ChatGPT (SIWC) 設定
# リモートホスト型（editor.zumen.dev）では OpenAI から発行された client_id (oaiapp_...) を設定する。
# ローカル開発（オープンソース動的クライアント）では dynamic_agent_client を指定可能。
OPENAI_SIWC_CLIENT_ID=dynamic_agent_client
# Confidential Client として発行された場合のみ設定（Public PKCE クライアントでは空のまま）
OPENAI_SIWC_CLIENT_SECRET=
# 動的クライアント登録時に識別するホスト ID（urn:uuid:... 形式。省略時は自動生成）
OPENAI_SIWC_HOST_ID=
# 同意画面へ表示するアプリ名ヒント
OPENAI_SIWC_AGENT_NAME=zumen-editor-web
# 要求スコープ（既定: ChatGPT Plan Usage 対応スコープ）
OPENAI_SIWC_SCOPES="openid profile email offline_access resource.invoke chatgpt.tokens.use.direct"
# OIDC Issuer（既定: https://auth.openai.com）
OPENAI_SIWC_ISSUER=https://auth.openai.com
# Responses API ベース URL（既定: https://api.openai.com/v1）
OPENAI_API_BASE_URL=https://api.openai.com/v1
